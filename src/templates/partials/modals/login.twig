{#
  partials/modals/login.twig
  data-ajax-method="template_modal" data-template="partials/modals/login" ile açılır.
  Güncel membership login sistemi — form-login-native.twig'i modal olarak render eder.
#}
<div class="modal-header border-0 pb-0">
    {% if logo.url %}
    <img src="{{ logo.url }}" alt="{{ site.name }}" style="max-height:36px;width:auto">
    {% endif %}
    <button type="button" class="btn-close ms-auto" data-bs-dismiss="modal" aria-label="{{ translate('Close') }}"></button>
</div>
<div class="modal-body p-0">
    {% include "my-account/form-login.twig" %}
</div>
