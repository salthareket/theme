{#
  lost-password.twig
  Modal — Şifre sıfırlama emaili gönder.
  Açılış: data-ajax-method='template_modal' data-template='partials/modals/lost-password'
  Submit: data-ajax-method="password_recover" → email'e link gönderilir
#}
<form id="form-lost-password"
      class="form needs-validation"
      autocomplete="off"
      novalidate>

    <div class="modal-header border-0 pb-0">
        <div class="d-flex flex-column gap-1">
            <h5 class="modal-title fw-bold">{{ translate("Lost your password?") }}</h5>
            <p class="text-muted small mb-0">{{ translate("Enter your email address and we'll send you a link to reset your password.") }}</p>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ translate('Close') }}"></button>
    </div>

    <div class="modal-body py-3">
        <div class="message mb-2"></div>
        <div class="mb-3">
            <label for="lost-password-email" class="form-label fw-semibold small">
                {{ translate("Email Address") }}
            </label>
            <input type="email"
                   id="lost-password-email"
                   class="form-control form-control-lg"
                   name="user_login"
                   placeholder="{{ translate('your@email.com') }}"
                   autocomplete="email"
                   required/>
            <div class="invalid-feedback">{{ translate("Please enter a valid email address.") }}</div>
        </div>
    </div>

    <div class="modal-footer border-0 pt-0 justify-content-stretch flex-column gap-2">
        <button type="submit" class="btn-submit btn btn-primary w-100">
            {{ translate("Send Reset Link") }}
        </button>
    </div>

</form>

<script>
(function($){
    // Modal lazy-load ile geldiğinde form_validate çalışmamış olabilir.
    // Inline submit handler ile direkt ajax_query kullanıyoruz.
    $('#form-lost-password').on('submit', function(e){
        e.preventDefault();
        var $form = $(this);
        var email = $form.find('input[name="user_login"]').val().trim();

        if (!email) {
            $form.find('.message').html(
                '<div class="alert alert-danger py-2 small">{{ translate("Please enter your email address.") }}</div>'
            );
            return;
        }

        var $btn = $form.find('.btn-submit').prop('disabled', true);
        $form.closest('.modal-content').addClass('loading-process');
        $form.find('.message').html('');

        var q = new ajax_query();
        q.method = 'password_recover';
        q.vars   = { user_login: email };
        q.done   = function(res){
            $btn.prop('disabled', false);
            $form.closest('.modal-content').removeClass('loading-process');
            var cls = (res.error) ? 'danger' : 'success';
            var msg = res.message || (res.error ? '{{ translate("An error occurred.") }}' : '{{ translate("Check your email for the reset link.") }}');
            $form.find('.message').html('<div class="alert alert-' + cls + ' py-2 small">' + msg + '</div>');
            if (!res.error) {
                setTimeout(function(){ $('.modal:visible').modal('hide'); }, 3000);
            }
        };
        q.request();
    });
})(jQuery);
</script>
