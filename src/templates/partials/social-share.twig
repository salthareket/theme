{#
  partials/social-share.twig — v2.0
  ─────────────────────────────────────────────────────────────────────
  Değişkenler:
    networks      : array   — aktif ağ key listesi
    all_networks  : array   — tüm ağ tanımları
    share_data    : {url, title, text, image}
    view          : 'button' | 'solid'
    style         : 'icon-only' | 'icon-text' | 'text-only'
    size          : 'sm' | 'md' | 'lg'
    layout        : 'horizontal' | 'vertical'
    color_cfg     : renk ayarları array'i
    ga4           : bool
    show_count    : bool
    via, hashtags : string
  ─────────────────────────────────────────────────────────────────────
#}

{% set _url    = share_data.url   ?? '' %}
{% set _title  = share_data.title ?? '' %}
{% set _text   = share_data.text  ?? _title %}
{% set _image  = share_data.image ?? '' %}
{% set _view   = view ?? 'button' %}
{% set _style  = style ?? 'icon-only' %}
{% set _cc     = color_cfg ?? {} %}

{# Size map #}
{% set _size_map = {'sm': '28px', 'md': '36px', 'lg': '44px'} %}
{% set _icon_map = {'sm': '13px', 'md': '15px', 'lg': '18px'} %}
{% set _font_map = {'sm': '11px', 'md': '12px', 'lg': '14px'} %}
{% set _btn_size  = _size_map[size]  ?? '36px' %}
{% set _icon_size = _icon_map[size]  ?? '15px' %}
{% set _font_size = _font_map[size]  ?? '12px' %}

{# Wrap class #}
{% set _wrap_cls = 'sh-social-share sh-social-share--' ~ _view ~ ' sh-social-share--' ~ _style ~ ' sh-social-share--' ~ (layout ?? 'horizontal') ~ ' sh-social-share--' ~ (size ?? 'md') %}

<div class="{{ _wrap_cls }}"
     data-share-url="{{ _url|e('html_attr') }}"
     data-share-title="{{ _title|e('html_attr') }}"
     data-share-text="{{ _text|e('html_attr') }}"
     data-share-image="{{ _image|e('html_attr') }}"
     data-ga4="{{ ga4 ? '1' : '0' }}"
     data-required-js="social-share">

    {% for net_key in networks %}
        {% set net = all_networks[net_key] ?? null %}
        {% if net %}

        {# ── URL build ── #}
        {% set _href = '#' %}
        {% if net.js_action is not defined or not net.js_action %}
            {% set _href = net.url_pattern
                |replace({'{url}':      _url|url_encode})
                |replace({'{title}':    _title|url_encode})
                |replace({'{text}':     _text|url_encode})
                |replace({'{image}':    _image|url_encode})
                |replace({'{via}':      (via ?? '')|url_encode})
                |replace({'{hashtags}': (hashtags ?? '')|url_encode})
            %}
        {% endif %}

        {# ── Renk hesapla ── #}
        {% set _brand = net.color ?? '#374151' %}

        {% if _view == 'solid' %}
            {# solid: arka plan yok, sadece icon rengi #}
            {% set _bg_color    = 'transparent' %}
            {% set _bg_hover    = 'transparent' %}
            {% set _icon_color  = (_cc.solid_color ?? 'brand') == 'brand' ? _brand : (_cc.solid_color_val ?? _brand) %}
            {% set _icon_hover  = (_cc.solid_hover  ?? 'brand') == 'brand' ? _brand : (_cc.solid_hover_val ?? _brand) %}
        {% else %}
            {# button: bg ve text rengi #}
            {% set _bg_color   = (_cc.btn_bg       ?? 'brand') == 'brand'  ? _brand   : (_cc.btn_bg_color ?? _brand) %}
            {% set _bg_hover   = (_cc.btn_bg_hover ?? 'brand') == 'brand'  ? _brand   : (_cc.btn_bg_hover_color ?? _brand) %}
            {% set _btn_txt    = _cc.btn_text ?? 'white' %}
            {% set _icon_color = _btn_txt == 'white' ? '#ffffff' : (_btn_txt == 'brand' ? _brand : (_cc.btn_text_color ?? '#ffffff')) %}
            {% set _btn_txt_h  = _cc.btn_text_hover ?? 'white' %}
            {% set _icon_hover = _btn_txt_h == 'white' ? '#ffffff' : (_btn_txt_h == 'brand' ? _brand : (_cc.btn_text_hover_color ?? '#ffffff')) %}
        {% endif %}

        {% set _target  = net.target    ?? '_blank' %}
        {% set _js_act  = net.js_action ?? '' %}
        {% set _mob_only = net.mobile_only ?? false %}

        <a href="{{ _href }}"
           class="sh-ss-btn sh-ss-btn--{{ net_key }}{% if _mob_only %} sh-ss-btn--native{% endif %}"
           target="{{ _target }}"
           rel="noopener noreferrer"
           title="{{ net.label|e('html_attr') }}"
           data-network="{{ net_key }}"
           {% if _js_act %}data-action="{{ _js_act }}"{% endif %}
           {% if _mob_only %}data-mobile-only="1"{% endif %}
           style="--sh-ss-bg:{{ _bg_color }};--sh-ss-bg-hover:{{ _bg_hover }};--sh-ss-text:{{ _icon_color }};--sh-ss-text-hover:{{ _icon_hover }};--sh-ss-brand:{{ _brand }};{% if _view != 'solid' %}--sh-ss-btn-size:{{ _btn_size }};--sh-ss-icon-size:{{ _icon_size }};--sh-ss-font-size:{{ _font_size }};{% endif %}">

            {% if _style != 'text-only' %}
                {{ fa_icon( net.icon, net.icon_style ?? 'solid', '' ) }}
            {% endif %}

            {% if _style != 'icon-only' %}
                <span class="sh-ss-btn__label">{{ net.label }}</span>
            {% endif %}

            {% if show_count %}
                <span class="sh-ss-btn__count" style="display:none">0</span>
            {% endif %}

        </a>

        {% endif %}
    {% endfor %}

</div>

<style data-inline="true">
/* ── Social Share ── */
.sh-social-share {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
}
.sh-social-share--vertical { flex-direction: column; align-items: flex-start; }

/* ── Base button ── */
.sh-ss-btn {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 6px;
    width: var(--sh-ss-btn-size, 36px);
    height: var(--sh-ss-btn-size, 36px);
    border-radius: 6px;
    text-decoration: none !important;
    transition: background .2s, color .2s, opacity .2s, transform .15s;
    cursor: pointer;
    border: 2px solid transparent;
    font-size: var(--sh-ss-font-size, 12px);
    font-weight: 600;
    white-space: nowrap;
    line-height: 1;
    box-sizing: border-box;
}
.sh-ss-btn:link, .sh-ss-btn:visited { text-decoration: none !important; }
.sh-ss-btn:hover { opacity: .9; transform: translateY(-1px); }
.sh-ss-btn:active { transform: scale(.96); }

/* ── Button view ── */
.sh-social-share--button .sh-ss-btn {
    background: var(--sh-ss-bg) !important;
    color: var(--sh-ss-text) !important;
}
.sh-social-share--button .sh-ss-btn:link,
.sh-social-share--button .sh-ss-btn:visited {
    color: var(--sh-ss-text) !important;
}
.sh-social-share--button .sh-ss-btn:hover {
    background: var(--sh-ss-bg-hover, var(--sh-ss-bg)) !important;
    color: var(--sh-ss-text-hover, var(--sh-ss-text)) !important;
    opacity: 1;
}

/* icon-only: kare buton */
.sh-social-share--icon-only .sh-ss-btn { width: var(--sh-ss-btn-size, 36px); padding: 0; }
/* icon-text / text-only: genişlik serbest */
.sh-social-share--icon-text .sh-ss-btn,
.sh-social-share--text-only .sh-ss-btn { width: auto; padding: 0 12px; }

/* ── Solid view ── */
.sh-social-share--solid .sh-ss-btn {
    background: transparent !important;
    border: none !important;
    border-radius: 0 !important;
    box-shadow: none !important;
    width: auto !important;
    height: auto !important;
    min-width: 0 !important;
    padding: 4px !important;
    color: var(--sh-ss-text) !important;
}
.sh-social-share--solid .sh-ss-btn:link,
.sh-social-share--solid .sh-ss-btn:visited { color: var(--sh-ss-text) !important; }
.sh-social-share--solid .sh-ss-btn:hover {
    color: var(--sh-ss-text-hover, var(--sh-ss-text)) !important;
    background: transparent !important;
    opacity: .75;
    transform: scale(1.1);
}
.sh-social-share--solid .sh-ss-btn svg.fa-icon,
.sh-social-share--solid .sh-ss-btn .fa-icon {
    width: 20px !important;
    height: 20px !important;
}

/* ── Solid size overrides ── */
.sh-social-share--solid.sh-social-share--sm .sh-ss-btn svg.fa-icon { width:16px!important;height:16px!important; }
.sh-social-share--solid.sh-social-share--lg .sh-ss-btn svg.fa-icon { width:24px!important;height:24px!important; }

/* Icon size */
.sh-ss-btn svg.fa-icon, .sh-ss-btn .fa-icon { font-size: var(--sh-ss-icon-size,15px); width: var(--sh-ss-icon-size,15px); height: var(--sh-ss-icon-size,15px); }

/* Copy feedback */
.sh-ss-btn--copy.copied { filter: brightness(.8); }

/* Native — JS gösterir */
.sh-ss-btn--native { display: none !important; }
.sh-ss-btn--native.visible { display: inline-flex !important; }

/* Count badge */
.sh-ss-btn__count { font-size:10px;font-weight:700;background:rgba(0,0,0,.15);border-radius:3px;padding:0 4px;min-width:18px;text-align:center; }
</style>
