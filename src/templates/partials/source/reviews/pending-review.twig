{#
  partials/source/reviews/pending-review.twig
  ─────────────────────────────────────────────────────────────────────────────
  Kullanıcının onaylanmamış review'unu review listesinin en üstünde gösterir.
  Sadece yorumu yazan kişi görür — bootstrap.php'de kontrol ediliyor.

  Context:
    review — array: id, content, rating, title, verified, approved, date,
             author, avatar, post {id, title, link}, is_owner, is_admin
#}

<div class="sh-pending-review alert alert-warning border-warning-subtle mb-3" role="alert">

    <div class="d-flex align-items-center gap-2 mb-2">
        <span class="badge bg-warning text-dark">
            ⏳ {{ translate('Pending Approval') }}
        </span>
        <span class="badge bg-info-subtle text-info" style="font-size:11px">
            {{ translate('Only you can see this') }}
        </span>
    </div>

    <div class="d-flex align-items-center gap-3 mb-2">
        {% if review.avatar %}
        <img src="{{ review.avatar }}" class="rounded-circle" width="40" height="40" alt="{{ review.author }}" />
        {% endif %}
        <div>
            <div class="fw-semibold small">{{ review.author }}</div>
            {% if review.date %}
            <small class="text-muted">{{ review.date }}</small>
            {% endif %}
        </div>
    </div>

    {% if review.rating %}
    <div class="mb-2">
        <span class="text-warning">
            {% for i in 1..5 %}{{ i <= review.rating ? '★' : '☆' }}{% endfor %}
        </span>
        <span class="fw-semibold small ms-1">{{ review.rating }}/5</span>
    </div>
    {% endif %}

    {% if review.title %}
    <div class="fw-semibold small mb-1">{{ review.title }}</div>
    {% endif %}

    {% if review.content %}
    <p class="mb-2 small" style="color:#374151;line-height:1.5">{{ review.content|nl2br }}</p>
    {% endif %}

    {# Delete butonu — kullanıcının kendi yorumunu silebilmesi #}
    <div class="d-flex gap-2 mt-2">
        <button type="button" class="btn btn-sm btn-outline-danger"
                data-id="{{ review.id }}" onclick="shReviewAction(this,'delete')">
            {{ fa_icon('trash','solid','me-1') }}{{ translate('Delete') }}
        </button>
    </div>

</div>
