{#
  partials/source/cart/archive.twig
  
  Context:
    items  — cart items array (woo_get_cart_object().items)
    meta   — {count, total}
    view   — offcanvas | dropdown | modal | my-account | feed | ...
    source — cart

  view modu:
    is_popup = true  (offcanvas/dropdown/modal) → {view}-body + {view}-footer wrapper'lı render
    is_popup = false (my-account, feed, vb.)    → yalın feed, wrapper yok, footer yok
#}

{% set is_popup = view in ['offcanvas', 'dropdown', 'modal'] %}

{% if is_popup %}<div class="{{ view }}-body">{% endif %}
    <div class="load-container">
        {% if items %}
            <ul class="source-list list-unstyled">
                {% for item in items %}
                    {% include 'partials/source/cart/tease.twig' with { item: item, view: view } %}
                {% endfor %}
            </ul>
        {% else %}
            {# ── Boş state ──────────────────────────────────────────── #}
            <div class="content-centered d-flex flex-column h-100 align-items-center justify-content-center text-center py-5">
                <div class="content-block d-flex flex-column align-items-center gap-3">
                    {{ fa_icon('shopping-basket', 'light', 'fa-3x opacity-25') }}
                    <p class="mb-0">{{ translate('Your cart is empty.') }}</p>
                    <a class="btn btn-primary btn-sm" href="{{ function('esc_url', function('apply_filters', 'woocommerce_return_to_shop_redirect', function('wc_get_page_permalink', 'shop'))) }}">
                        {{ translate('Start Shopping') }}
                    </a>
                </div>
            </div>
        {% endif %}
    </div>
{% if is_popup %}</div>{% endif %}

{# ── Footer — sadece popup modda VE sepet doluyken render edilir ──────
   Bos sepette footer HTML'i HIC gonderilmez. Aksi halde main.js
   _renderSourceResult footer wrapper'ini bulup ($footContent.length>0)
   'd-none'i kaldiriyor ve bos sepette de TOTAL/checkout footer'i gorunuyordu. #}
{% if is_popup and items %}
<div class="{{ view }}-footer">
    {% include 'partials/source/cart/footer.twig' with { meta: meta, view: view } %}
</div>
{% endif %}
