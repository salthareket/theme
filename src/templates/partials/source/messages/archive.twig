{#
  partials/source/messages/archive.twig

  Context:
    items   — messages array
    meta    — {count, page, page_total}
    view    — offcanvas | dropdown | modal | my-account | feed | ...
    source  — messages

  view modu:
    is_popup = true  (offcanvas/dropdown/modal) → {view}-body + {view}-footer wrapper'lı render
    is_popup = false (my-account, feed, vb.)    → yalın feed, wrapper yok, footer yok
#}

{% set is_popup = view in ['offcanvas', 'dropdown', 'modal'] %}

{% if is_popup %}<div class="{{ view }}-body">{% endif %}
    <div class="source-container"
         data-source="messages"
         data-view="{{ view }}"
         data-page="{{ meta.page|default(1) }}"
         data-page-total="{{ meta.page_total|default(1) }}"
         data-posts-per-page="{{ meta.per_page|default(15) }}">

        {% if items %}
            <ul class="source-list list-unstyled messages-list">
                {% for item in items %}
                    {% include 'partials/source/messages/tease.twig' with { item: item, view: view } %}
                {% endfor %}
            </ul>
        {% else %}
            <div class="content-centered d-flex flex-column h-100 align-items-center justify-content-center text-center py-5">
                <div class="content-block d-flex flex-column align-items-center gap-3">
                    {{ fa_icon('envelope', 'regular', 'fa-3x opacity-25') }}
                    <p class="mb-0">{{ translate('No new messages.') }}</p>
                </div>
            </div>
        {% endif %}

        {% if meta.page < meta.page_total %}
            <div class="source-load-more text-center py-2 d-none">
                <button type="button" class="btn btn-sm btn-link source-load-more-btn"
                        data-method="get_messages"
                        data-next-page="{{ meta.page + 1 }}">
                    {{ translate('Load More') }}
                </button>
            </div>
        {% endif %}

    </div>
{% if is_popup %}</div>{% endif %}

{# Footer — sadece popup modda render edilir #}
{% if is_popup %}
<div class="{{ view }}-footer{% if not items %} d-none{% endif %}">
    {% include 'partials/source/messages/footer.twig' with { meta: meta, view: view } %}
</div>
{% endif %}
