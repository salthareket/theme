{#
  partials/source/notifications/tease.twig

  Context:
    item — notification object {id, title, message, time, url, read, sender{name, image}}
    view — offcanvas | dropdown | modal
#}

<li class="source-item source-item-notification notification-item{% if not item.read %} unread{% endif %}"
    data-source="notifications"
    data-id="{{ item.id }}">

    <a href="{{ item.url|default('#') }}" class="d-flex gap-3 align-items-start text-decoration-none">

        {# Sender avatar #}
        {% if item.sender.image %}
            <div class="source-item-avatar flex-shrink-0">
                {{ item.sender.image|raw }}
            </div>
        {% endif %}

        {# Detay #}
        <div class="source-item-detail flex-grow-1 min-w-0" style="min-width:0;overflow:hidden">
            {% if item.sender.name %}
                <div class="source-item-title fw-semibold">{{ item.sender.name }}</div>
            {% endif %}
            {% if item.message %}
                <div class="source-item-message text-muted" style="word-break:break-word;overflow-wrap:break-word">{{ item.message }}</div>
            {% endif %}
            {% if item.time %}
                <small class="source-item-time text-muted">{{ item.time }}</small>
            {% endif %}
        </div>

        {# Okunmamış göstergesi #}
        {% if not item.read %}
            <span class="source-item-badge badge bg-primary rounded-circle p-1 flex-shrink-0"></span>
        {% endif %}

    </a>
</li>
