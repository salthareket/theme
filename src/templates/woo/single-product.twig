{# <?php #}
{#
  woo/single-product.twig — TEMA OVERRIDE
  Vendor single-product.twig'i override eder.
  Kitap spesifik kodlar temizlendi. Layout vendor ile aynı korundu.
  Structured data hidden meta olarak eklendi.
  initial_variation: PHP'den inject edilir (variation URL'de).
#}
{% extends "base.twig" %}

{% set page_settings_default = {
    full : true,
    classes : {
        body : "page-single-product",
        main : "pb-0",
        container : "",
        gap : "",
    },
    add_offcanvas : 0,
    offcanvas : {
        individual : false,
        size : "md",
        width : 3,
        position : "start",
        template : "",
        title : "",
    },
    alert : {
        type : "danger",
        title : "",
        message : "",
        position : "bottom",
        fixed : false,
        class : "",
        html : ""
    },
    paging : {
        posts_per_page : 10,
        page : 1
    }
} %}
{% if page_settings %}
    {% set page_settings = page_settings_default|array_merge_recursive_items(page_settings) %}
{% else %}
    {% set page_settings = page_settings_default %}
{% endif %}

{% block shop_header %}
    {% include "woo/header.twig" %}
{% endblock %}

{% set product_type = post.get_product_type %}
{% set iv_title = initial_variation.title ?? post.title %}
{% set iv_desc  = initial_variation.description ?? null %}

{% block content %}

    {# Schema.org hidden meta — container dışında, layout'u etkilemez #}
    <span itemscope itemtype="https://schema.org/Product" style="display:none">
        <meta itemprop="name"        content="{{ iv_title|e }}"/>
        <meta itemprop="description" content="{{ (post.excerpt ?? post.content)|striptags|trim|e }}"/>
        {% if post.thumbnail %}
        <meta itemprop="image"       content="{{ post.thumbnail.src('woocommerce_single') }}"/>
        {% endif %}
        {% if post.sku %}
        <meta itemprop="sku"         content="{{ post.sku }}"/>
        {% endif %}
        {% set _brand = post.terms('wpc-brand')[0] ?? post.terms('product_brand')[0] ?? null %}
        {% if _brand %}
        <span itemprop="brand" itemscope itemtype="https://schema.org/Brand">
            <meta itemprop="name" content="{{ _brand }}"/>
        </span>
        {% endif %}
    </span>

    {# ── Layout — vendor ile birebir aynı, kitap kodları yok ── #}
    <div class="product single-product-details {{ post.class }}">
        <div class="container">
            <div class="row gx-lg-5">

                {# SOL: Galeri #}
                <div class="col-lg-5">
                    <div class="sticky-top">
                        {{ post.product_gallery() }}
                    </div>
                </div>

                {# SAĞ: İçerik #}
                <div class="col-lg-7">

                    {% do action('woocommerce_before_single_product') %}

                    <h1 class="card-title text-lg-start text-center mb-0 product_title entry-title">{{ iv_title }}</h1>

                    {% do action('sh_product_rating_summary', post.id) %}
                    {% do action('sh_product_stats', post.id) %}

                    <meta itemprop="url" content="{{ post.link }}" />

                    <div class="woocommerce-product-details__short-description product-description">
                        {% if iv_desc %}
                            {{ iv_desc|raw }}
                        {% else %}
                            {{ post.content }}
                        {% endif %}
                    </div>

                    {{ sh_social_share() }}

                    <div class="summary entry-summary">
                        {% do action('woocommerce_single_product_summary') %}
                    </div>

                    {% do action('woocommerce_after_single_product_summary') %}

                    {% include 'woo/partials/product-tabs.twig' %}

                    {% do action('woocommerce_after_single_product') %}
                </div>

            </div>
        </div>
    </div>

    {% include 'woo/partials/sticky-atc.twig' %}

    {% include 'woo/partials/product-list.twig' with {'list_type': 'related'} %}
    {% include 'woo/partials/product-list.twig' with {'list_type': 'upsell'} %}
    {% include 'woo/partials/product-list.twig' with {'list_type': 'crosssell'} %}
    {% include 'woo/partials/product-list.twig' with {'list_type': 'recently_viewed'} %}

{% endblock %}

{% block appendix %}
<script>
$(document).ready(function() {
    if (typeof text2clipboard === 'function') text2clipboard();
});
</script>
{% endblock %}
