{% block hero %}
{% endblock %}

{% block shop_header %}
{% endblock %}

{% block hero_header %}
{% endblock %}

{% block content %}

    <div class="card-search-results card-reset card container-lg" data-template="search/tease" data-html-whitelist=".pagination, .pagination-*, .btn-pagination-*, .page-item, .page-link">
        <div class="card-header d-flex pb-5 text-center">
            <h1 class="card-title">
                {{title}}
                <small class="d-block">
                    {% if found_posts %}
                        {{ translate_nooped_plural( translate_n_noop( '%s result found.', '%s results found.'), found_posts)|format(found_posts) }}
                    {% endif %}
                </small>
            </h1>
        </div>

        {% include "partials/pagination/pagination-advanced.twig" with { container : ".posts", post_type : "search", direction : "prev"} %}

        <div class="card-body">
            <div class="posts row row-cols-1 gy-3">
                {% if found_posts %} 
                    {% for post in posts %}
                        <div class="col">
                            {% include "search/tease.twig" %}
                        </div>
                    {% endfor %}
                {% else %}
                    <div class="col py-5">
                        <div class="d-flex flex-column text-center align-items-center gap-3">
                            {{ fa_icon('face-sad-sweat', 'light', 'opacity-25 fa-5x mb-3') }}
                            <h4>{{ description }}</h4>

                            {# Did you mean? — benzer terim/post önerisi #}
                            {% if keyword %}
                                {% set _did_you_mean = function('did_you_mean_search', keyword, 2) %}
                                {% if _did_you_mean and _did_you_mean != keyword %}
                                <p class="text-muted mb-0">
                                    {{ translate('Did you mean %s?')|replace({'%s':
                                        '<a href="' ~ function('home_url', '/search/') ~  _did_you_mean|url_encode ~ '" class="fw-semibold text-primary">' ~ _did_you_mean ~ '</a>'
                                    })|raw }}
                                </p>
                                {% endif %}
                            {% endif %}
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>

        {% include "partials/pagination/pagination-advanced.twig" with { container : ".posts", post_type : "search", direction : "next"} %}

    </div>

{% endblock %}


{% block bottom %}
{% endblock %}