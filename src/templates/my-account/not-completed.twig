{#
  not-completed.twig
  Aktive edilmiş ama profili tamamlanmamış kullanıcı kısıtlı endpointlere
  gitmeye çalışınca yönlendirilir (sessions, messages, financials vb.)
  user.profile_completion — ['success' => bool, key => ['title', 'success', 'url']]
#}
<div class="container-sm py-5">
<div class="row justify-content-center">
<div class="col-md-8 col-lg-6 text-center">

    {{ fa_icon('user-gear', 'light', 'fa-4x text-secondary opacity-50') }}
    <h2 class="fw-bold mt-3 mb-2">{{ translate("Complete your profile") }}</h2>
    <p class="text-muted mb-4">
        {% if description %}
            {{ description }}
        {% else %}
            {{ translate("Please complete the following sections of your profile before accessing this area.") }}
        {% endif %}
    </p>

    <div class="d-flex flex-wrap gap-3 justify-content-center">
        {% for key, item in user.profile_completion %}
            {% if key != "success" and not item.success %}
            <a href="{{ base_urls.account }}{{ key }}/"
               class="btn btn-primary px-4 btn-loading-page">
                {{ item.title }}
            </a>
            {% endif %}
        {% endfor %}
    </div>

</div>
</div>
</div>
