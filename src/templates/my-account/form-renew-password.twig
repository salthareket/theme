{#
  form-renew-password.twig
  URL'de ?activation-password=xxx varken render edilir (giriş yapmamış kullanıcı).
  AJAX: data-ajax-method="update_profile" + action=renew_password hidden field.
  activation-password query param Encrypt sınıfıyla şifrelenmiş token içerir.
#}
<div class="container-sm py-5">
    <div class="row justify-content-center">
        <div class="col-12">

            <div class="text-center mb-4">
                {{ fa_icon('lock-keyhole', 'light', 'fa-4x text-secondary opacity-50') }}
                <h2 class="fw-bold mt-3 mb-1">{{ translate("Set New Password") }}</h2>
                <p class="text-muted small">{{ translate("Choose a strong password you haven't used before.") }}</p>
            </div>

            <form id="form-renew-password"
                  class="form form-validate needs-validation"
                  autocomplete="off"
                  method="post"
                  novalidate
                  data-ajax-method="update_profile">

                <div class="card shadow-sm border-0 rounded-4">
                    <div class="card-body p-4">

                        <div class="mb-3">
                            <label for="rp-password" class="form-label fw-semibold">
                                {{ translate("New Password") }}
                            </label>
                            <input type="password"
                                   id="rp-password"
                                   name="password"
                                   class="form-control form-control-lg"
                                   autocomplete="new-password"
                                   placeholder="••••••••"
                                   minlength="8"
                                   required/>
                            <div class="form-text text-muted small">{{ translate("Minimum 8 characters.") }}</div>
                            <div class="invalid-feedback">{{ translate("Please enter a new password.") }}</div>
                        </div>

                        <div class="mb-4">
                            <label for="rp-password-confirm" class="form-label fw-semibold">
                                {{ translate("Confirm New Password") }}
                            </label>
                            <input type="password"
                                   id="rp-password-confirm"
                                   name="password_1"
                                   class="form-control form-control-lg"
                                   autocomplete="new-password"
                                   placeholder="••••••••"
                                   data-rule-equalto="#rp-password[name='password']"
                                   data-msg="{{ translate('Passwords do not match.') }}"
                                   required/>
                            <div class="invalid-feedback">{{ translate("Passwords do not match.") }}</div>
                        </div>

                        <input type="hidden" name="activation-password" value="{{ activation_password }}"/>
                        <input type="hidden" name="action" value="renew_password"/>

                        <div class="d-grid">
                            <button type="submit" class="btn-submit btn btn-primary btn-lg fw-bold">
                                {{ translate("Reset Password") }}
                            </button>
                        </div>

                    </div>
                </div>

            </form>

        </div>
    </div>
</div>
