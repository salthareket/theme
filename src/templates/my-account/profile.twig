{#
  my-account/profile.twig
  ─────────────────────────────────────────────────────────────────────────────
  Kullanıcı profil düzenleme formu.

  Context değişkenleri (startersite.php / my-account template'inden gelir):
    user                 — ThemeUser nesnesi
    enable_ecommerce     — bool: WooCommerce aktif mi
    enable_postcode_validation — bool
    register_fields      — MembershipSettings::getSetting('register_fields')
    profile_url_prefix   — function('membership_profile_url_prefix', wp_user)
    social_networks      — function('membership_social_networks')
    countries            — function('salt_get_countries')

  YENİ ALAN EKLEMEK İÇİN:
  1. İlgili section card'ına yeni form-group satırı ekle
  2. HandlesProfile::saveProfile() içine kayıt mantığını ekle
  3. Gerekiyorsa MembershipSettings register_fields'a da ekle
  ─────────────────────────────────────────────────────────────────────────────
#}

{# ── Helpers ─────────────────────────────────────────────────────────────── #}
{% set _rf              = register_fields ?? function('SaltHareket\\Membership\\MembershipSettings::getSetting', 'register_fields') ?? {} %}
{% set _profile_prefix  = function('membership_profile_url_prefix') %}
{% set _social_networks = function('membership_social_networks') %}
{% set _countries       = function('salt_get_countries') ?? [] %}

{# Mevcut ülke — billing_country yoksa phone_code'dan tespit #}
{% set _billing_country = user.billing_country %}
{% if _billing_country is empty and user.meta('billing_phone_code') is not empty %}
    {% set _phone_code_raw = user.meta('billing_phone_code')|replace({'+': ''}) %}
    {% for _c in _countries %}
        {% if _c.phonecode ~ '' == _phone_code_raw ~ '' and _billing_country is empty %}
            {% set _billing_country = _c.iso2 %}
        {% endif %}
    {% endfor %}
{% endif %}

{# Mevcut şehir/eyalet durumu #}
{% set _country_has_state = 0 %}
{% for _c in _countries %}
    {% if _c.iso2 == _billing_country %}
        {% set _country_has_state = _c.states|boolval %}
    {% endif %}
{% endfor %}

{# Mevcut sosyal medya verileri — [{"brand": "facebook", "url": "..."}] #}
{% set _social_media_data = [] %}
{% if _social_networks %}
    {% for _key, _net in _social_networks %}
        {% if user.meta(_key) is not empty %}
            {% set _social_media_data = _social_media_data|merge([{'brand': _key, 'url': user.meta(_key)}]) %}
        {% endif %}
    {% endfor %}
{% endif %}

{# Email doğrulama uyarısı #}
{% if user._email_temp %}
<div class="alert alert-warning d-flex align-items-center gap-2 mb-4" role="alert">
    <span>{{ translate("Please verify") }} <strong>{{ user._email_temp }}</strong>.</span>
    <a href="#" class="ms-auto btn btn-sm btn-outline-warning" data-ajax-method="send_email_activation" data-id="{{ user.id }}">{{ translate("Resend") }}</a>
    <a href="#" class="btn btn-sm btn-outline-secondary" data-ajax-method="reset_email_activation" data-id="{{ user.id }}">{{ translate("Cancel") }}</a>
</div>
{% endif %}

<form id="form-update-profile"
      class="form form-validate needs-validation sh-no-error-summary"
      method="post"
      data-ajax-method="update_profile"
      autocomplete="off"
      novalidate>

    <input type="hidden" name="action" value="profile">

    {# ════════════════════════════════════════════════════════════════════════
       BÖLÜM 1 — HAKKIMDA
       ════════════════════════════════════════════════════════════════════════ #}
    <div class="card mb-4 border-0 shadow-sm">
        <div class="card-header bg-transparent border-bottom fw-semibold py-3">
            {{ translate("About You") }}
        </div>
        <div class="card-body">
            <div class="row g-3">

                {# First Name #}
                {% if _rf.first_name.enabled ?? true %}
                <div class="col-12 col-sm-6">
                    <label class="form-label fw-semibold small">{{ translate("First Name") }} <span class="text-danger">*</span></label>
                    <input type="text" class="form-control form-control-lg"
                           name="first_name" value="{{ user.first_name }}"
                           autocomplete="given-name" required>
                </div>
                {% endif %}

                {# Last Name #}
                {% if _rf.last_name.enabled ?? true %}
                <div class="col-12 col-sm-6">
                    <label class="form-label fw-semibold small">{{ translate("Last Name") }} <span class="text-danger">*</span></label>
                    <input type="text" class="form-control form-control-lg"
                           name="last_name" value="{{ user.last_name }}"
                           autocomplete="family-name" required>
                </div>
                {% endif %}

                {# Title / Description #}
                <div class="col-12">
                    <label class="form-label fw-semibold small">{{ translate("Title") }}</label>
                    <input type="text" class="form-control form-control-lg"
                           name="description" value="{{ user.description }}"
                           autocomplete="off">
                </div>

                {# About #}
                <div class="col-12">
                    <label class="form-label fw-semibold small">{{ translate("About") }}</label>
                    <textarea class="form-control" name="about" rows="4" autocomplete="off">{{ user.about }}</textarea>
                </div>

                {# Dynamic register field'lar — admin'den eklenen veya enabled olan tüm field'lar #}
                {# type:'select' / 'custom_select' / 'product_attributes' → select render        #}
                {# type:'text'                                             → text input render    #}
                {# built-in özel field'lar (phone, country, state) aşağıdaki BÖLÜM 3'te render edilir #}
                {% set _builtin_special = ['first_name', 'last_name', 'phone', 'country', 'state'] %}
                {% for _fkey, _fdata in _rf %}
                    {% if (_fdata.enabled ?? false) and _fkey not in _builtin_special %}

                    {% set _flabel = _fdata.label is not empty ? _fdata.label : (_fkey|replace({'_': ' '})|title) %}
                    {% set _ftype  = _fdata.type ?? 'text' %}

                    {% if _ftype == 'text' %}
                    {# ── Text input ──────────────────────────────────────────── #}
                    <div class="col-12 col-sm-6">
                        <label class="form-label fw-semibold small">{{ translate(_flabel) }}{% if _fdata.required ?? false %} <span class="text-danger">*</span>{% endif %}</label>
                        <input type="text" class="form-control form-control-lg"
                               name="{{ _fkey }}"
                               value="{{ user.meta(_fkey) }}"
                               {% if _fdata.required ?? false %}required{% endif %}>
                    </div>

                    {% elseif _ftype in ['select', 'custom_select', 'product_attributes'] %}
                    {# ── Select / Radio / Checkbox ───────────────────────────── #}
                    {# product_attributes type için options'ı WC taxonomy term'lerinden al #}
                    {% if _ftype == 'product_attributes' and _fdata.attribute_slug is not empty %}
                        {% set _pa_raw = function('get_terms', _fdata.attribute_slug, {'hide_empty': false, 'orderby': 'menu_order', 'order': 'ASC'}) %}
                        {% set _pa_options = {} %}
                        {% if _pa_raw and _pa_raw is not empty %}
                            {% for _term in _pa_raw %}
                                {% set _pa_options = _pa_options|merge({(_term.slug): _term.name}) %}
                            {% endfor %}
                        {% endif %}
                    {% else %}
                        {% set _pa_options = _fdata.options ?? {} %}
                    {% endif %}

                    {% if _pa_options is not empty %}
                    {% set _fui = _fdata.ui_type ?? 'select' %}
                    <div class="col-12 col-sm-6">
                        <label class="form-label fw-semibold small">{{ translate(_flabel) }}{% if _fdata.required ?? false %} <span class="text-danger">*</span>{% endif %}</label>

                        {% if _fui == 'radio' %}
                            {% for _optval, _optlabel in _pa_options %}
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio"
                                       name="{{ _fkey }}"
                                       id="prf_{{ _fkey }}_{{ _optval }}"
                                       value="{{ _optval }}"
                                       {% if user.meta(_fkey) == _optval %}checked{% endif %}
                                       {% if _fdata.required ?? false %}required{% endif %}>
                                <label class="form-check-label" for="prf_{{ _fkey }}_{{ _optval }}">{{ translate(_optlabel) }}</label>
                            </div>
                            {% endfor %}

                        {% elseif _fui == 'checkbox' %}
                            {% set _current_vals = user.meta(_fkey) %}
                            {% for _optval, _optlabel in _pa_options %}
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="checkbox"
                                       name="{{ _fkey }}[]"
                                       id="prf_{{ _fkey }}_{{ _optval }}"
                                       value="{{ _optval }}"
                                       {% if _current_vals is iterable and _optval in _current_vals %}checked
                                       {% elseif _current_vals == _optval %}checked{% endif %}>
                                <label class="form-check-label" for="prf_{{ _fkey }}_{{ _optval }}">{{ translate(_optlabel) }}</label>
                            </div>
                            {% endfor %}

                        {% else %}
                            {# select (default) #}
                            <select name="{{ _fkey }}" class="form-select form-select-lg"
                                    {% if _fdata.required ?? false %}required{% endif %}>
                                {% for _optval, _optlabel in _pa_options %}
                                <option value="{{ _optval }}" {% if user.meta(_fkey) == _optval %}selected{% endif %}>
                                    {{ translate(_optlabel) }}
                                </option>
                                {% endfor %}
                            </select>
                        {% endif %}
                    </div>
                    {% endif %}{# /_pa_options not empty #}

                    {% endif %}{# /_ftype #}
                    {% endif %}{# /enabled #}
                {% endfor %}

            </div>
        </div>
    </div>

    {# ════════════════════════════════════════════════════════════════════════
       BÖLÜM 2 — İLETİŞİM
       ════════════════════════════════════════════════════════════════════════ #}
    <div class="card mb-4 border-0 shadow-sm">
        <div class="card-header bg-transparent border-bottom fw-semibold py-3">
            {{ translate("Contacts") }}
        </div>
        <div class="card-body">
            <div class="row g-3">

                {# Profile URL #}
                {% if enable_public_profile is defined and enable_public_profile %}
                <div class="col-12">
                    <label class="form-label fw-semibold small">{{ translate("Profile URL") }}</label>
                    <div class="input-group input-group-lg">
                        <span class="input-group-text text-muted small text-nowrap">
                            {{ site.url|trim('/') }}/{{ _profile_prefix }}
                        </span>
                        <input type="text"
                               class="form-control"
                               name="nickname"
                               value="{{ user.generate_url_slug() }}"
                               placeholder="{{ translate('your-username') }}"
                               autocomplete="off"
                               data-remote="nickname_exist"
                               data-remote-param="nickname"
                               data-remote-exclude="{{ user.generate_url_slug() }}"
                               data-rule-username-rule="true"
                               data-msg-username-rule="{{ translate('Only lowercase letters, numbers and dash.') }}"
                               data-slug
                               minlength="3"
                               maxlength="50">
                    </div>
                    <div class="form-text text-muted">{{ translate("Lowercase letters, numbers and dash only.") }}</div>
                </div>
                {% endif %}

                {# Website #}
                <div class="col-12 col-sm-6">
                    <label class="form-label fw-semibold small">{{ translate("Website") }}</label>
                    <input type="url" class="form-control form-control-lg"
                           name="user_url" value="{{ user.user_url }}"
                           placeholder="https://" autocomplete="url">
                </div>

                {# E-mail #}
                <div class="col-12 col-sm-6">
                    <label class="form-label fw-semibold small">{{ translate("E-mail") }} <span class="text-danger">*</span></label>
                    <input type="email" class="form-control form-control-lg"
                           name="email" value="{{ user.user_email }}"
                           data-rule="email"
                           data-remote="user_exist"
                           data-remote-param="email"
                           data-remote-exclude="{{ user.user_email }}"
                           autocomplete="email" required>
                    {% if user._email_temp %}
                    <div class="form-text text-danger">{{ user._email_temp }} {{ translate("is not verified yet!") }}</div>
                    {% endif %}
                </div>

                {# Social Media — repeater #}
                {% if _social_networks %}
                <div class="col-12">
                    <label class="form-label fw-semibold small">{{ translate("Social Media") }}</label>

                    <div id="sh-social-repeater">
                        {# Mevcut kayıtlar #}
                        {% if _social_media_data %}
                            {% for _item in _social_media_data %}
                            <div class="sh-repeater-row d-flex gap-2 mb-2 align-items-center">
                                <span class="sh-drag-handle text-muted" style="cursor:grab;padding:0 4px;font-size:16px" title="Drag to reorder">⠿</span>
                                <select name="social_media[{{ loop.index0 }}][brand]" class="form-select" style="max-width:180px">
                                    {#<option value="">{{ translate("Platform") }}</option>#}
                                    {% for _key, _net in _social_networks %}
                                    <option value="{{ _key }}" {% if _item.brand == _key %}selected{% endif %}>{{ _net.label }}</option>
                                    {% endfor %}
                                </select>
                                <input type="url" name="social_media[{{ loop.index0 }}][url]" class="form-control"
                                       value="{{ _item.url }}" placeholder="https://" autocomplete="off">
                                <button type="button" class="btn btn-outline-secondary btn-sm flex-shrink-0 sh-repeater-remove">
                                    {{ fa_icon('times', 'solid') }}
                                </button>
                            </div>
                            {% endfor %}
                        {% endif %}
                    </div>

                    <button type="button" id="sh-social-add" class="btn btn-outline-primary btn-sm w-100 mt-1">
                        {{ fa_icon('plus', 'regular', 'fa-fw me-1') }}{{ translate("Add Social Media") }}
                    </button>

                    {# Template satır — JS klonlar #}
                    <template id="sh-social-row-tpl">
                        <div class="sh-repeater-row d-flex gap-2 mb-2 align-items-center">
                            <span class="sh-drag-handle text-muted" style="cursor:grab;padding:0 4px;font-size:16px" title="Drag to reorder">⠿</span>
                            <select name="social_media[brand][]" class="form-select" style="max-width:180px">
                                {% for _key, _net in _social_networks %}
                                <option value="{{ _key }}">{{ _net.label }}</option>
                                {% endfor %}
                            </select>
                            <input type="url" name="social_media[url][]" class="form-control"
                                   placeholder="https://" autocomplete="off">
                            <button type="button" class="btn btn-danger btn-sm flex-shrink-0 sh-repeater-remove">
                                {{ fa_icon('times', 'solid') }}
                            </button>
                        </div>
                    </template>
                </div>
                {% endif %}

            </div>
        </div>
    </div>

    {# ════════════════════════════════════════════════════════════════════════
       BÖLÜM 3 — KONUM & İLETİŞİM BİLGİLERİ
       ════════════════════════════════════════════════════════════════════════ #}
    {% if _rf.country.enabled or _rf.state.enabled or _rf.phone.enabled %}
    <div class="card mb-4 border-0 shadow-sm">
        <div class="card-header bg-transparent border-bottom fw-semibold py-3">
            {{ translate("Location") }}
        </div>
        <div class="card-body">
            <div class="row g-3">

                {# Country #}
                {% if _rf.country.enabled and _countries %}
                <div class="col-12 col-sm-6">
                    <label class="form-label fw-semibold small">{{ translate("Country") }}{% if _rf.country.required %} <span class="text-danger">*</span>{% endif %}</label>
                    <select class="form-select form-select-lg"
                            name="country"
                            id="profile-country-select"
                            {% if _rf.country.required %}required{% endif %}>
                        <option value="">{{ translate("Select your country") }}</option>
                        {% for _c in _countries %}
                        <option value="{{ _c.iso2 }}"
                                data-phonecode="{{ _c.phonecode }}"
                                data-states="{{ _c.states }}"
                                {% if _c.iso2 == _billing_country %}selected{% endif %}>
                            {{ _c.name }}
                        </option>
                        {% endfor %}
                    </select>
                    <input type="hidden" name="states_view" id="profile-states-view" value="{{ _country_has_state }}">
                </div>
                {% endif %}

                {# State / City #}
                {% if _rf.state.enabled %}
                <div class="col-12 col-sm-6 {% if not _country_has_state %}d-none{% endif %}" id="profile-state-wrap">
                    <label class="form-label fw-semibold small">{{ translate("City / State") }}{% if _rf.state.required %} <span class="text-danger">*</span>{% endif %}</label>
                    <select class="form-select form-select-lg"
                            name="city"
                            id="profile-state-select"
                            {% if _rf.state.required %}required{% endif %}>
                        <option value="">{{ translate("Select city/district") }}</option>
                        {% if _billing_country %}
                            {% set _cities = function('salt_get_states', _billing_country) %}
                            {% if _cities %}
                                {% for _city in _cities %}
                                <option value="{{ _city.id }}"
                                        {% if _city.id == user.city %}selected{% endif %}>{{ _city.name }}</option>
                                {% endfor %}
                            {% endif %}
                        {% endif %}
                    </select>
                </div>
                {% endif %}

                {# Phone Number — her zaman col-12, kendi satırında #}
                {% if _rf.phone.enabled %}
                <div class="col-12">
                    <label class="form-label fw-semibold small">{{ translate("Phone Number") }}{% if _rf.phone.required %} <span class="text-danger">*</span>{% endif %}</label>
                    <div class="input-group input-group-lg">
                        {% if _countries %}
                        <select name="phone_code" id="profile-phone-code"
                                class="form-select flex-shrink-0" style="max-width:160px"
                                aria-label="{{ translate('Country code') }}">
                            {% for _c in _countries %}
                            <option value="+{{ _c.phonecode }}"
                                    data-iso="{{ _c.iso2 }}"
                                    {% if user.meta('billing_phone_code') == '+' ~ _c.phonecode or (user.meta('billing_phone_code') is empty and _c.iso2 == _billing_country) %}selected{% endif %}>
                                +{{ _c.phonecode }}
                            </option>
                            {% endfor %}
                        </select>
                        {% else %}
                        <input type="text" name="phone_code" id="profile-phone-code"
                               class="form-control flex-shrink-0" style="max-width:100px"
                               value="{{ user.meta('billing_phone_code') ?: '+90' }}"
                               placeholder="+90" maxlength="6">
                        {% endif %}
                        <input type="tel" name="phone" id="profile-phone-input"
                               class="form-control form-control-phone"
                               value="{{ user.billing_phone }}"
                               placeholder="555 000 00 00"
                               autocomplete="tel"
                               data-pv-skip="1"
                               {% if _rf.phone.required %}required{% endif %}>
                    </div>
                </div>
                {% endif %}

            </div>
        </div>
    </div>
    {% endif %}

    {# ════════════════════════════════════════════════════════════════════════
       KAYDET
       ════════════════════════════════════════════════════════════════════════ #}
    <div class="d-grid">
        <button type="submit" class="btn-submit btn btn-primary btn-lg fw-bold">
            {{ translate("Save Changes") }}
        </button>
    </div>

</form>

{# ── JS: Country → Phone mask + State/City chain ────────────────────────── #}
<script>
(function($){
    // ── Social Media Repeater ─────────────────────────────────────────────
    function shSocialUpdateOptions() {
        // Seçili brand'leri topla
        var selected = [];
        $('#sh-social-repeater .sh-repeater-row select[name^="social_media"]').each(function(){
            var v = $(this).val();
            if(v) selected.push(v);
        });
        // Her select'in option'larını güncelle — kendi seçili değeri hariç used olanları gizle
        $('#sh-social-repeater .sh-repeater-row select[name^="social_media"]').each(function(){
            var $sel = $(this);
            var own  = $sel.val();
            $sel.find('option').each(function(){
                var v = $(this).val();
                if(!v) return;
                var isUsedByOther = v !== own && selected.indexOf(v) !== -1;
                $(this).prop('disabled', isUsedByOther)
                       .toggleClass('d-none', isUsedByOther);
            });
        });
    }

    // ── Drag-drop sıralama (HTML5 Drag API — dependency yok) ─────────────────
    function shSocialInitSortable() {
        var $list = document.getElementById('sh-social-repeater');
        if (!$list) return;

        var _dragging = null;

        $list.addEventListener('dragstart', function(e) {
            var row = e.target.closest('.sh-repeater-row');
            if (!row) return;
            _dragging = row;
            row.style.opacity = '0.5';
            e.dataTransfer.effectAllowed = 'move';
        });

        $list.addEventListener('dragend', function(e) {
            var row = e.target.closest('.sh-repeater-row');
            if (row) row.style.opacity = '';
            _dragging = null;
            // Index'leri güncelle
            $($list).find('.sh-repeater-row').each(function(i){
                $(this).find('select[name^="social_media"]').attr('name', 'social_media[' + i + '][brand]');
                $(this).find('input[type="url"][name^="social_media"]').attr('name', 'social_media[' + i + '][url]');
            });
        });

        $list.addEventListener('dragover', function(e) {
            e.preventDefault();
            e.dataTransfer.dropEffect = 'move';
            var target = e.target.closest('.sh-repeater-row');
            if (target && target !== _dragging) {
                var rect = target.getBoundingClientRect();
                var mid  = rect.top + rect.height / 2;
                if (e.clientY < mid) {
                    $list.insertBefore(_dragging, target);
                } else {
                    $list.insertBefore(_dragging, target.nextSibling);
                }
            }
        });

        // Handle'ı draggable yap
        $(document).on('mousedown', '.sh-drag-handle', function(){
            $(this).closest('.sh-repeater-row').attr('draggable', 'true');
        }).on('mouseup', '.sh-drag-handle', function(){
            $(this).closest('.sh-repeater-row').attr('draggable', 'false');
        });
    }
    shSocialInitSortable();

    $('#sh-social-add').on('click', function(){
        var tpl = document.getElementById('sh-social-row-tpl');
        if(!tpl) return;
        var clone = tpl.content.cloneNode(true);
        // Yeni index = mevcut satır sayısı
        var idx = $('#sh-social-repeater .sh-repeater-row').length;
        $(clone).find('select').attr('name', 'social_media[' + idx + '][brand]');
        $(clone).find('input[type="url"]').attr('name', 'social_media[' + idx + '][url]');
        document.getElementById('sh-social-repeater').appendChild(clone);

        // Zaten seçili olan brand'leri topla
        var used = [];
        $('#sh-social-repeater .sh-repeater-row select[name^="social_media"]').not(':last').each(function(){
            var v = $(this).val();
            if(v) used.push(v);
        });

        // Yeni satırdaki select'e henüz kullanılmayan ilk option'ı seç
        var $newSel = $('#sh-social-repeater .sh-repeater-row:last select[name^="social_media"]');
        var selected = false;
        $newSel.find('option').each(function(){
            var v = $(this).val();
            if(v && used.indexOf(v) === -1 && !selected){
                $newSel.val(v);
                selected = true;
            }
        });

        shSocialUpdateOptions();
    });
    $(document).on('click', '.sh-repeater-remove', function(){
        $(this).closest('.sh-repeater-row').remove();
        // Kalan satırların index'lerini yeniden numaralandır
        $('#sh-social-repeater .sh-repeater-row').each(function(i){
            $(this).find('select[name^="social_media"]').attr('name', 'social_media[' + i + '][brand]');
            $(this).find('input[name^="social_media"]').attr('name', 'social_media[' + i + '][url]');
        });
        shSocialUpdateOptions();
    });
    $(document).on('change', '#sh-social-repeater select[name^="social_media"]', function(){
        shSocialUpdateOptions();
    });
    // Sayfa yüklenince mevcut seçimlere göre disable et
    shSocialUpdateOptions();

    // Country değişince: phone code güncelle + state/city yükle + phone mask güncelle
    $(document).on('change', '#profile-country-select', function(){
        var $sel     = $(this);
        var $opt     = $sel.find('option:selected');
        var country  = $sel.val();
        var states   = parseInt($opt.data('states') || 0);
        var phonecode= $opt.data('phonecode') || '';

        // Phone code güncelle
        if(phonecode){
            var $phoneCode = $('#profile-phone-code');
            if($phoneCode.is('select')){
                $phoneCode.find('option').filter(function(){
                    return $(this).data('iso') === country;
                }).prop('selected', true).trigger('change.phonemask');
            } else {
                $phoneCode.val('+' + phonecode);
            }
        }

        // states_view güncelle
        $('#profile-states-view').val(states ? '1' : '0');

        // State/city yükle
        var $wrap   = $('#profile-state-wrap');
        var $select = $('#profile-state-select');
        if(states > 0){
            $wrap.removeClass('d-none');
            $select.html('<option value="">{{ translate("Loading...")|escape('js') }}</option>');
            var apiUrl = (typeof ajax_request_vars !== 'undefined')
                ? ajax_request_vars.site_url.replace(/\/$/, '') + '/api/get_states/'
                : '/api/get_states/';
            var nonce = (typeof ajax_request_vars !== 'undefined') ? ajax_request_vars.ajax_nonce : '';
            $.ajax({
                url: apiUrl, method: 'POST', contentType: 'application/json',
                headers: nonce ? {'X-WP-Nonce': nonce} : {},
                data: JSON.stringify({vars: {country_code: country}}),
                success: function(res){
                    $select.html('<option value="">{{ translate("Select city/district")|escape('js') }}</option>');
                    if(res && !res.error && res.data && res.data.length){
                        $.each(res.data, function(i, s){
                            $select.append('<option value="'+s.id+'">'+s.name+'</option>');
                        });
                    } else { $wrap.addClass('d-none'); }
                },
                error: function(){ $wrap.addClass('d-none'); }
            });
        } else {
            $wrap.addClass('d-none');
            $select.html('<option value="">{{ translate("Select city/district")|escape('js') }}</option>');
        }
    });

    // Nickname — orijinal değerle aynıyken remote skip (data-remote-exclude ile server-side handle ediliyor)

})(jQuery);
</script>
