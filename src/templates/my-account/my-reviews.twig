{#
  my-account/my-reviews.twig
  view_tab PHP'den güvenilir gelemiyor — JS URL'den okur
  authored tab: tüm yorumlar gelir (approved+pending), sil butonu var
  on_me / on_posts: approve/reject butonu, status filter
#}

{% set _status   = (action == 'approved') ? 1 : 0 %}
{% set _base_url = function('get_account_endpoint_url', 'reviews') %}
{% set _action   = (action == 'authored') ? 'approved' : action %}

<div class="card-container card card-reset">

    <div class="card-header d-flex align-items-center flex-wrap gap-2 pb-0 border-bottom-0">
        {% if title %}<h2 class="card-title h4 mb-0 me-auto">{{ title }}</h2>{% endif %}

        {# Status dropdown — JS authored tab'da gizler #}
        {% if not disable_review_approve and statuses %}
        <div class="ms-auto sh-review-status-wrap">
            <div class="btn-group">
                <button type="button"
                        class="btn btn-sm btn-secondary fw-bold text-uppercase dropdown-toggle"
                        data-bs-toggle="dropdown" aria-expanded="false">
                    {% for s in statuses %}{% if s.slug == action or (action == 'authored' and s.slug == 'approved') %}{{ s.name }} (<span class="sh-status-count">{{ s.count }}</span>){% endif %}{% endfor %}
                </button>
                <ul class="dropdown-menu dropdown-menu-end p-2 rounded-3">
                    {% for s in statuses %}
                    <li>
                        <a class="dropdown-item rounded-2 {% if s.slug == action %}fw-bold{% endif %}"
                           href="{{ _base_url }}{{ s.slug }}/?tab=TABPLACEHOLDER">
                            {{ s.name }} ({{ s.count }})
                        </a>
                    </li>
                    {% endfor %}
                </ul>
            </div>
        </div>
        {% endif %}
    </div>

    {# Tab'lar #}
    <div class="card-header border-bottom pt-2 pb-0">
        <ul class="nav nav-tabs border-0 gap-1">
            <li class="nav-item">
                <a class="nav-link sh-rev-tab" data-tab="on_me"
                   href="{{ _base_url }}{{ _action }}/?tab=on_me">
                    {{ translate("Reviews on Me") }}
                    {% if received_pending > 0 %}
                    <span class="badge rounded-pill bg-warning text-dark ms-1">{{ received_pending }}</span>
                    {% endif %}
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link sh-rev-tab" data-tab="on_posts"
                   href="{{ _base_url }}{{ _action }}/?tab=on_posts">
                    {{ translate("Reviews on My Posts") }}
                    {% if on_posts_pending is defined and on_posts_pending > 0 %}
                    <span class="badge rounded-pill bg-warning text-dark ms-1">{{ on_posts_pending }}</span>
                    {% endif %}
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link sh-rev-tab" data-tab="authored"
                   href="{{ _base_url }}authored/?tab=authored">
                    {{ translate("My Reviews") }}
                </a>
            </li>
        </ul>
    </div>

    <div class="ajax-paginate-pending"
         id="reviews-list"
         data-ajax-method="get_reviews"
         data-view="my-account"
         data-posts_per_page="10"
         data-user="{{ user.id }}"
         data-order="desc"
         data-load_type="scroll"
         data-status="{{ _status }}"
         data-mode="on_me"
         data-page="1"
         data-notfound="partials/not-found/reviews">

        <ul class="list-cards source-list list-unstyled reviews-list mb-0"></ul>

        <div class="card-footer justify-content-end">
            <a href="#" class="btn-next-page btn btn-light btn-extend w-100 loading" data-init="true" style="visibility:hidden;height:1px;overflow:hidden;padding:0;margin:0">
                <span>{{ translate('Load More') }} <span class="item-left"></span></span>
            </a>
        </div>
    </div>

</div>

<script>
(function($){
    var urlParams  = new URLSearchParams(window.location.search);
    var currentTab = urlParams.get('tab') || 'on_me';
    var validTabs  = ['on_me', 'on_posts', 'authored'];
    if (validTabs.indexOf(currentTab) === -1) currentTab = 'on_me';

    var $list = $('#reviews-list');
    var $btn  = $list.find('.btn-next-page');

    // authored tab: tüm yorumlar (approved+pending) — status filtresi yok
    if (currentTab === 'authored') {
        $list.attr('data-mode', 'authored');
        $list.removeAttr('data-status');
        $('.sh-review-status-wrap').hide();
    } else {
        $list.attr('data-mode', currentTab);
    }

    // Tab active class
    $('.sh-rev-tab').each(function(){
        $(this).toggleClass('active', $(this).data('tab') === currentTab);
    });

    // Status dropdown linklerindeki TABPLACEHOLDER'ı değiştir
    $('.sh-review-status-wrap a').each(function(){
        $(this).attr('href', $(this).attr('href').replace('TABPLACEHOLDER', currentTab));
    });

    // Buton görünürlüğünü yönet — MutationObserver ile loading class'ını izle
    // loading eklenince: göster | loading kalkınca: gizle veya d-none
    function showBtn()  { $btn.css({ visibility: '', height: '', overflow: '', padding: '', margin: '' }); }
    function hideBtn()  { $btn.css({ visibility: 'hidden', height: '1px', overflow: 'hidden', padding: '0', margin: '0' }); }
    function removeBtn(){ $btn.addClass('d-none').css({ visibility: '', height: '', overflow: '', padding: '', margin: '' }); }

    var observer = new MutationObserver(function(mutations) {
        mutations.forEach(function(m) {
            if (m.attributeName === 'class') {
                var $el = $(m.target);
                if ($el.hasClass('loading') || $el.hasClass('processing')) {
                    showBtn();
                } else if ($el.hasClass('d-none') || $el.hasClass('completed')) {
                    // ui.js d-none ekledi — tüm sayfalar yüklendi
                    removeBtn();
                } else {
                    hideBtn();
                }
            }
        });
    });

    if ($btn.length) {
        observer.observe($btn[0], { attributes: true, attributeFilter: ['class'] });
    }

    // Şimdi class'ı ekle — mode/status doğru set edildikten sonra ajax_paginate init etsin
    $list.addClass('ajax-paginate');
    setTimeout(function(){
        if (typeof ajax_paginate === 'function') ajax_paginate();
    }, 50);

    // AJAX response gelince count'u güncelle
    $(document).on('ajax_query:complete', function(e, obj){
        if (obj && obj.method === 'get_reviews' && obj.result && obj.result.data) {
            var count = obj.result.data.count || 0;
            $('.sh-status-count').text(count);
        }
    });

    // Approve/reject/delete AJAX
    window.shReviewAction = function(btn, action) {
        var id = btn.dataset.id;
        if (!id) return;
        if (action === 'delete' && !confirm('{{ translate("Delete this review?") }}')) return;
        btn.disabled = true;
        var nonce   = (window.ajax_request_vars && ajax_request_vars.ajax_nonce) || '';
        var apiBase = (window.ajax_request_vars && ajax_request_vars.site_url)
            ? ajax_request_vars.site_url.replace(/\/$/, '') : '';
        fetch(apiBase + '/api/sh_review_owner_action/', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-WP-Nonce': nonce },
            body: JSON.stringify({ vars: { id: id, action: action } })
        })
        .then(function(r){ return r.json(); })
        .then(function(res) {
            if (res.success || !res.error) {
                var $li = $(btn).closest('li');
                if (action === 'delete') {
                    $li.fadeOut(300, function(){ $li.remove(); });
                } else {
                    window.location.reload();
                }
            } else {
                alert(res.message || 'Error');
                btn.disabled = false;
            }
        })
        .catch(function(){ btn.disabled = false; });
    };

    // Review modal aç — kullanıcının kendi yorumunu modal'da göster
    window.shReviewOpenModal = function(commentId) {
        function _openModal(html, title) {
            if (typeof bootbox !== 'undefined') {
                bootbox.dialog({
                    title: title || '{{ translate("Your Review") }}',
                    message: html,
                    size: 'md',
                    closeButton: true,
                    className: 'sh-review-modal'
                });
            } else {
                var $m = $('<div class="modal fade" tabindex="-1"><div class="modal-dialog modal-md"><div class="modal-content"></div></div></div>');
                $m.find('.modal-content').html('<div class="modal-header"><h5 class="modal-title">'+(title||'Review')+'</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>'+html);
                $('body').append($m);
                var bs = new bootstrap.Modal($m[0]);
                bs.show();
                $m.on('hidden.bs.modal', function(){ $m.remove(); });
            }
        }

        var q = new ajax_query();
        q.method = 'review_modal';
        q.vars = { id: commentId };
        q.done = function(res) {
            if (res && !res.error && res.html) {
                _openModal(res.html, (res.data && res.data.title) || '{{ translate("Your Review") }}');
            } else {
                alert((res && res.message) || '{{ translate("Review not found.") }}');
            }
        };
        q.request();
    };

})(jQuery);
</script>
