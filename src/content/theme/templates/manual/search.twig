{% set url = function("home_url") ~ "/search/" %}

<div class="offcanvas-body align-items-center">
    <div class="container-md text-center">
                        {% if function("class_exists", 'DGWT_WC_Ajax_Search' ) %}
                            {{ '[fibosearch]'|shortcodes }}
                            {% if not _keyword %}
                                {% set _popular = function('sh_get_popular_search_terms', 'search', 10) %}
                                {% if _popular %}
                                <div class="search-history-terms text-center mt-2">
                                    <label>Popular searches</label>
                                    <ul class="list-inline mb-0 justify-content-center">
                                        {% for term in _popular %}
                                        <li class="list-inline-item mb-1">
                                            <a href="{{ url }}{{ term }}"
                                               class="btn btn-sm btn-outline-primary btn-loading-page">
                                                {{ term }}
                                            </a>
                                        </li>
                                        {% endfor %}
                                    </ul>
                                </div>
                                {% endif %}
                            {% endif %}
                        {% endif %}
{#

